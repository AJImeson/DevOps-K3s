# .gitignore

# Secrets, credentials, keys
# Anything below here leaking into history is a compliance incident, not a bug.
*.pem
*.key
*.crt
*.cer
*.der
*.p12
*.pfx
*.jks
*.keystore
id_rsa
id_rsa.*
id_ed25519
id_ed25519.*
*.ppk
known_hosts

.env
.env.*
!.env.example
!.env.sample
!.env.template

secrets.yml
secrets.yaml
secrets/
credentials
credentials.json
*.credentials

# direnv - the .direnv cache always; .envrc only if it holds real values.
# If your .envrc is pure `dotenv` + PATH tweaks, un-ignore it.
.direnv/
.envrc
#----------------------------------------------------------------------------

# Terraform
# State is remote (GitLab HTTP backend), but never rely on that alone.
.terraform/
.terraform.tfstate.lock.info
terraform.tfstate
terraform.tfstate.*
*.tfstate
*.tfstate.*
crash.log
crash.*.log

# Saved plans - binary, may contain resolved secret values
tfplan
*.tfplan
terraform/tfplan

# Variable files. Commit only the example.
*.tfvars
*.tfvars.json
!example.tfvars
!terraform.tfvars.example

override.tf
override.tf.json
*_override.tf
*_override.tf.json

.terraformrc
terraform.rc

# NOTE: .terraform.lock.hcl SHOULD be committed - it pins provider versions.

#----------------------------------------------------------------------------
# Ansible
*.retry
.ansible/
.vault_pass
.vault-password
vault_pass.txt
ansible.log
ansible/inventory.ini

# Dynamic / generated inventories. Static committed inventories should be
# un-ignored explicitly.
inventory.ini.generated
hosts.generated
*.inventory.generated

roles/external/
collections/ansible_collections/


# Kubernetes / K3s / Helm
kubeconfig
kubeconfig.*
*.kubeconfig
.kube/
k3s.yaml

# envsubst render output - templates are committed, renders are not.
rendered/
K3s/**/*.rendered.yaml
*.rendered.yaml
*.generated.yaml

# Plaintext input to SealedSecrets. The sealed output IS committed;
# the unsealed source must never be.
*.unsealed.yaml
*-secret.plain.yaml
secret-*.plain.yaml
#----------------------------------------------------------------------------

# Helm
charts/*.tgz
*.tgz
.helm/
#----------------------------------------------------------------------------

# .NET / ASP.NET Core
bin/
obj/
out/
[Dd]ebug/
[Rr]elease/
[Bb]in/
[Oo]bj/
x64/
x86/
publish/
PublishProfiles/*.user

*.user
*.suo
*.userprefs
*.userosscache
*.sln.docstates
.vs/

TestResults/
[Tt]est[Rr]esult*/
*.trx
*.coverage
*.coverlet.json
coverage*.json
coverage*.xml
coverage*.info

*.nupkg
*.snupkg
project.lock.json
project.fragment.lock.json
artifacts/

msbuild.log
msbuild.err
msbuild.wrn

appsettings.*.local.json
appsettings.Local.json
#----------------------------------------------------------------------------

# Node / React / Vite
node_modules/
dist/
dist-ssr/
build/
.vite/
.cache/
*.local

npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

.eslintcache
.stylelintcache
*.tsbuildinfo
#----------------------------------------------------------------------------

# Python (deploy.py, tooling scripts)
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
.venv/
venv/
env/
ENV/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/
.coverage
.coverage.*
htmlcov/
#----------------------------------------------------------------------------

# Docker
docker-compose.override.yml
docker-compose.override.yaml
.docker/
*.tar
#----------------------------------------------------------------------------

# Security scan output
gl-sast-report.json
gl-secret-detection-report.json
gl-dependency-scanning-report.json
gl-container-scanning-report.json
trivy-report.*
semgrep-report.*
*.sarif
gitleaks-report.json
checkov-report.*
.trivyignore.local
#----------------------------------------------------------------------------

# Editors / IDE
*.swp
*.swo
*.swn
*~
Session.vim
.netrwhist
tags
tags.lock
tags.temp

.vscode/
!.vscode/extensions.json
.idea/
*.iml
*.sublime-workspace
*.sublime-project
#----------------------------------------------------------------------------

# OS cruft
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
desktop.ini
#----------------------------------------------------------------------------

# Logs, temp, local scratch
*.log
logs/
tmp/
temp/
.tmp/
*.bak
*.orig
*.rej
*.pid
*.seed

scratch/
.local/
NOTES.local.md





